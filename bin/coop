#!/usr/bin/env bash
#
# coop - Bannerlord Coop Server Installer & Manager
#
# The single entry point. Everything a user or a script does goes through
# here; the libraries under lib/ never talk to the terminal on their own.
#
# https://github.com/PlodyIce/bannerlordcoop-server-manager

set -uo pipefail

# Output this manager parses must not be translated. On a German host
# `apt-cache policy` prints "Installationskandidat:" where the dependency
# check looked for "Candidate:" - so every dependency was reported as
# unavailable and the installer refused a perfectly good Debian machine.
# C.UTF-8 where it exists, so a campaign name with non-ASCII characters
# still passes through unharmed.
case $'\n'"$(locale -a 2>/dev/null || true)"$'\n' in
    *$'\n'C.UTF-8$'\n'*) export LC_ALL=C.UTF-8 ;;
    *)                   export LC_ALL=C ;;
esac

# Resolve the project root through any symlink, so /usr/local/bin/coop
# finds its libraries wherever the repository was cloned.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link="$(readlink "$_self")"
    [[ "$_link" == /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
COOP_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
readonly COOP_ROOT
unset _self _link

for _lib in common output config state docker server license bans campaign steam mods compat deps backup update provision health; do
    # shellcheck source=/dev/null
    . "${COOP_ROOT}/lib/${_lib}.sh" || { echo "coop: cannot load lib/${_lib}.sh" >&2; exit 1; }
done
unset _lib

install_traps

# --------------------------------------------------------------- usage --
usage() {
    cat <<'HELPTEXT'
coop - Bannerlord Coop Server Installer & Manager

USAGE
    coop [global options] <command> [options]

SETUP
    install                 Install a server on this host
      --default               Recommended defaults, three questions
      --advanced              Configure ports, paths, backups and updates
      --non-interactive       Never prompt; missing values are an error
    eula                    Are the server's license terms accepted?
    eula show               Read them
    eula accept             Accept them, so the server can start

RUNNING
    status                  Show what the server is doing
    start | stop | restart  Start or stop the server, with a closing save
    save                    Force a save and wait for it
    console <command>       Send a command to the server console
                            (status players save say kick help)
    logs [--follow] [-n N]  Show the server log

CAMPAIGNS
    campaign list           The campaigns in saves/, and which one is hosted
    campaign use <name>     Host an existing campaign: backup, then switch
    campaign new <name>     Start a new world, leaving the others alone

MODS
    mods [list]             Installed mods, and what players need
    mods add <id|link>...   Install Steam Workshop mods: backup, then restart
    mods remove <id>...     Remove mods: backup, then restart
    mods update             Install newer versions of the mods
      --check                 Only report whether there are any

PLAYERS
    ban [list]              List banned Steam accounts
    ban <steam64-id>        Ban a Steam account; no restart needed
      --name "<hero name>"    Note who it was
    unban <steam64-id>      Lift a ban

CONFIGURATION
    config                  Edit common settings
      --advanced              Include the less common ones
      --list                  Show every setting, its value and default
      --get KEY               Print one value
      --set KEY=VALUE         Change one value. SAVE_NAME must name an
                              existing campaign unless --new-world is given
      --apply                 Regenerate files and restart if needed

SOFTWARE
    update                  Install a newer Coop build
      --check                 Only report whether one exists
      --force                 Install even if the check says otherwise
    rollback                Go back to the previous Coop build
    steam status|login|logout

DATA
    backup [--note "..."]   Create a backup now
    backup list             List backups
    backup info <id>        Show what is in one
    backup restore [<id>]   Restore saves and configuration
                            (without an ID, pick from a list)
    import-save <dir>       Import campaign saves from a directory

DIAGNOSTICS
    doctor                  Check the installation and say what is wrong
    version                 Show the manager and Coop versions

GLOBAL OPTIONS
    --install-dir <path>    Operate on the installation in <path>
    --instance <id>         Operate on a named instance
    --config <file>         Read settings from <file>
    --json                  Machine-readable output where supported
    --non-interactive       Never prompt
    --yes                   Answer confirmations with yes
    --accept-eula           Accept the server's license terms without a
                            prompt. --yes never does; read them first.
    --quiet                 Only warnings and errors
    --verbose               Extra detail
    -h, --help              This text

Every setting can also be passed as a flag, derived from its name:
    --save-name "My Campaign"   --game-port 4210   --backup-keep-auto 24
See 'coop config --list' for the full set.

EXIT CODES
    0 success   2 usage   10 configuration   20 dependency   30 Steam
    40 runtime  50 health 60 backup/restore  70 locked   80 license terms
HELPTEXT
}

# ------------------------------------------------- global option parsing --
# Global options may appear before or after the command. Anything that is
# not one is passed through to the command.
ARGS=()
CONFIG_FILE=""

# Turns --save-name into SAVE_NAME, so every setting in the spec is a flag
# without having to be listed twice.
_flag_to_key() {
    local f="${1#--}"
    printf '%s' "${f//-/_}" | tr '[:lower:]' '[:upper:]'
}

while (( $# )); do
    case "$1" in
        --json)            OUTPUT_FORMAT="json"; shift ;;
        --non-interactive) NON_INTERACTIVE=1; shift ;;
        --yes|-y)          ASSUME_YES=1; shift ;;
        --accept-eula)     COOP_ACCEPT_EULA=1; shift ;;
        --quiet|-q)        QUIET=1; shift ;;
        --verbose|-v)      VERBOSE=1; shift ;;
        --config)          CONFIG_FILE="${2:?--config needs a file}"; shift 2 ;;
        --install-dir)     CFG_OVERRIDE[INSTALL_DIR]="${2:?--install-dir needs a path}"; shift 2 ;;
        --instance)        CFG_OVERRIDE[INSTANCE_ID]="${2:?--instance needs an id}"; shift 2 ;;
        -h|--help)         usage; exit 0 ;;
        --version)         ARGS+=("version"); shift ;;

        # Convenient aliases for the names the documentation uses.
        --password)          CFG_OVERRIDE[SERVER_PASSWORD]="${2:-}"; shift 2 ;;
        --channel)           CFG_OVERRIDE[INSTALL_CHANNEL]="${2:-}"; shift 2 ;;
        --backup-retention)  CFG_OVERRIDE[BACKUP_KEEP_AUTO]="${2:-}"; shift 2 ;;

        --*=*)
            _k="$(_flag_to_key "${1%%=*}")"
            if [[ -n "${CONFIG_SPEC[$_k]:-}" ]]; then
                CFG_OVERRIDE["$_k"]="${1#*=}"; shift
            else
                ARGS+=("$1"); shift
            fi ;;
        --*)
            _k="$(_flag_to_key "$1")"
            if [[ -n "${CONFIG_SPEC[$_k]:-}" && $# -ge 2 && "${2:0:1}" != "-" ]]; then
                CFG_OVERRIDE["$_k"]="$2"; shift 2
            else
                ARGS+=("$1"); shift
            fi ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
unset _k

set -- "${ARGS[@]:-}"
COOP_COMMAND="${1:-status}"
[[ $# -gt 0 ]] && shift

config_load ${CONFIG_FILE:+--config "$CONFIG_FILE"}

# ---------------------------------------------------------- sanity gate --
# Most commands are meaningless without an installation, and saying so
# plainly beats a stack of confusing errors further down.
require_installation() {
    installation_present && return 0

    # An installation directory that exists but cannot be entered is a
    # permission problem, not a missing installation. It is 0750 on
    # purpose, because it holds the server password, so this is what an
    # ordinary user sees - and "no installation found" would send them off
    # to install a second one over the top of the first.
    if [[ -d "$INSTALL_DIR" && ! -x "$INSTALL_DIR" ]]; then
        fail "$EX_CONFIG" \
            "Cannot read $INSTALL_DIR as $(id -un)." \
            "The directory belongs to root and the service user, because it holds the server password." \
            "Try:  sudo coop ${COOP_COMMAND}"
    fi

    fail "$EX_CONFIG" \
        "No Bannerlord Coop installation found in $INSTALL_DIR." \
        "Install one with:  sudo coop install" \
        "Or point at an existing one:  coop --install-dir <path> ${COOP_COMMAND}"
}

# ------------------------------------------------------------- commands --
cmd_install() {
    local mode="" skip_download=0 fresh=1 arg
    installation_present && fresh=0
    for arg in "$@"; do
        case "$arg" in
            --default)  mode="default" ;;
            --advanced) mode="advanced" ;;
            *) fail "$EX_USAGE" "Unknown option for install: $arg" ;;
        esac
    done
    require_root

    out_title "Bannerlord Coop Server Installer"
    out_line "  Manager v${MANAGER_VERSION}"
    out_line ""

    # ---- existing installation ---------------------------------------
    # Asked before the compatibility check, not after. "Can this machine
    # run a server" is the wrong first question to put to a machine that
    # is already running one; what the user wants there is update, repair
    # or reconfigure. Only reconfigure continues into the steps below.
    if installation_present; then
        provision_existing_menu
        case "$EXISTING_CHOICE" in
            1) exec "$0" ${OUTPUT_FORMAT:+--json} update ;;
            2) log "Repairing"; provision_run 1
               license_require "$DIR_SERVER" || exit "$EX_LICENSE"
               server_start; provision_validate; exit $? ;;
            # Reconfiguring changes settings, not the build, so there is
            # nothing to fetch. provision_run downloads anyway if it finds
            # no server files - which is what happens if the directory or
            # channel is changed along the way.
            3) mode="advanced"; skip_download=1 ;;
            *) log "Nothing was changed."; exit 0 ;;
        esac
    fi

    # ---- [1/8] read-only system check --------------------------------
    out_line "[1/8] System compatibility"
    local pf=0
    compat_preflight "$INSTALL_DIR" "$(cfg GAME_PORT)" || pf=$?
    compat_report
    case "$pf" in
        2) fail "$EX_DEPS" \
               "This system cannot run a Bannerlord Coop server." \
               "Each failing line above says why. No changes have been made to your system." ;;
        1) confirm "Continue despite the warnings above?" no \
               || { log "Nothing was changed."; exit 0; } ;;
    esac

    # ---- [2/8] setup mode --------------------------------------------
    if [[ -z "$mode" ]]; then
        if (( NON_INTERACTIVE )); then
            mode="default"
        else
            out_line ""
            out_line "[2/8] Setup mode"
            out_line ""
            out_line "  [1] Default setup"
            out_line "      Recommended. Sensible defaults, three questions."
            out_line ""
            out_line "  [2] Advanced setup"
            out_line "      Ports, paths, backups, updates and other options."
            out_line ""
            local choice; ask choice "Select setup mode" "1"
            [[ "$choice" == "2" ]] && mode="advanced" || mode="default"
        fi
    fi

    # ---- [3/8] collect ------------------------------------------------
    if (( ! NON_INTERACTIVE )); then
        out_line ""
        out_line "[3/8] Server configuration"
        case "$mode" in
            advanced) provision_collect_advanced ;;
            *)        provision_collect_default ;;
        esac
        # The advanced questions can change the installation directory or
        # the instance id, so the derived paths are recomputed. Only the
        # paths: reloading the configuration here would read defaults.env
        # back over the answers that were just given.
        config_derive_paths
    fi
    config_validate_all

    # ---- [4/8] summary ---------------------------------------------------
    # The confirmation comes before anything is installed, which is why it
    # sits ahead of Steam rather than after it: authenticating with Steam
    # needs SteamCMD, SteamCMD runs in a container, and installing Docker
    # is a change to the host. Up to this line the promise still holds -
    # nothing on this system has been touched.
    out_line ""
    out_line "[4/8] Summary"
    provision_summary
    confirm "Install with these settings?" yes || { log "Nothing was changed."; exit 0; }

    # ---- [5/8] dependencies ----------------------------------------------
    out_line ""
    out_line "[5/8] Dependencies"
    acquire_lock install
    deps_install_base
    deps_install_docker
    deps_ensure_service_user
    deps_suggest_daemon_config

    # ---- [6/8] steam ------------------------------------------------------
    out_line ""
    out_line "[6/8] Steam authentication"
    if [[ "$(cfg INSTALL_CHANNEL)" == "workshop" ]]; then
        case "$(steam_status)" in
            absent)
                if (( NON_INTERACTIVE )); then
                    fail "$EX_STEAM" \
                        "No Steam session is present in $DIR_STEAM." \
                        "Steam Guard cannot be answered without a terminal." \
                        "Authenticate once with 'coop steam login', then re-run this install."
                fi
                steam_login ;;
            *) ok "Steam session present ($(cfg STEAM_USERNAME))" ;;
        esac
    else
        ok "Custom build channel, so Steam is not used"
    fi

    # ---- [7/8] provisioning ----------------------------------------------
    out_line ""
    out_line "[7/8] Installation"
    provision_run "$skip_download"
    state_set setup_profile "$mode"
    _install_cli_symlink

    # A fresh installation is the one place where a new world is the
    # expected outcome rather than a possible typo. On a reconfigure it
    # takes an explicit yes, which the collector asked for.
    if ! campaign_exists "$(cfg SAVE_NAME)" && { (( fresh )) || (( CAMPAIGN_NEW_WORLD_OK )); }; then
        campaign_allow_new_world "$(cfg SAVE_NAME)"
    fi

    # ---- [8/8] start and validation --------------------------------------
    out_line ""
    out_line "[8/8] Starting the server"

    # The license terms ship with the server files, so this is the first
    # moment there is anything to read - and nothing has been started yet.
    # Declining is not a failed installation: everything is in place, and
    # the server waits for a decision.
    if server_installed && ! license_require "$DIR_SERVER"; then
        out_line ""
        out_line "Installation complete, but the server was not started."
        out_line ""
        out_line "  The Coop server does not host a campaign until its license terms"
        out_line "  have been accepted. Once you have read them:"
        out_line ""
        out_line "    coop eula accept"
        out_line "    coop start"
        out_line ""
        exit "$EX_LICENSE"
    fi

    if ! server_installed; then
        warn "No server files are installed, so there is nothing to start."
    elif container_running; then
        # Reconfiguring reaches this point with the old container still
        # up. Settings such as the port or the password only take effect
        # on a restart, and reporting "installation complete" over a
        # server still running the previous configuration would be a lie.
        log "Restarting so the new configuration takes effect"
        server_stop
        server_start || warn "The server did not reach 'serving'. See: coop logs"
    else
        server_start || warn "The server did not reach 'serving'. See: coop logs"
    fi

    provision_validate || true

    out_line "Installation complete."
    out_line ""
    out_kv "Connect to" "$(host_primary_address):$(cfg GAME_PORT)"
    out_kv "Password"   "$( [[ -n "$(cfg SERVER_PASSWORD)" ]] && printf 'set' || printf 'none' )"
    out_kv "Campaign"   "$(cfg SAVE_NAME)"
    out_kv "Next"       "coop status"
    out_line ""
    out_line "  Players join through Direct Connect in the co-op menu."
    mods_configured && out_line "  They need the same mods, in the same versions. Which: coop mods"

    local others; others="$(host_addresses | tail -n +2 | tr '\n' ' ')"
    [[ -n "${others// /}" ]] && out_line "  Other addresses on this host: ${others% }"

    out_line ""
    _install_firewall_note
    out_line ""
}

# Says what is actually true on this host, rather than a generic reminder.
# Phrased as troubleshooting rather than as a step. UDP 4200 is open on
# most hosts already, and presenting it as a required action sends people
# off to configure something that usually needs no configuring.
_install_firewall_note() {
    out_line "  If somebody cannot connect, the usual cause is UDP $(cfg GAME_PORT) being"
    out_line "  blocked at your hosting provider. That firewall is the one that"
    out_line "  governs this port."
    if [[ "$(firewall_state)" == "active" ]]; then
        out_line ""
        out_line "  ufw is active here, but it is not the place to look: Docker"
        out_line "  publishes container ports ahead of ufw's rules, so allowing or"
        out_line "  denying UDP $(cfg GAME_PORT) there changes nothing."
    fi
}

_install_cli_symlink() {
    local target=/usr/local/bin/coop
    [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "${COOP_ROOT}/bin/coop")" ]] && return 0
    ln -sf "${COOP_ROOT}/bin/coop" "$target" \
        && ok "CLI available as 'coop'" \
        || warn "Could not create $target. Call ${COOP_ROOT}/bin/coop directly."
}

cmd_config() {
    local mode="" key value arg new_world=0
    for arg in "$@"; do
        case "$arg" in
            --advanced)  mode="advanced" ;;
            --list)      mode="list" ;;
            --apply)     mode="apply" ;;
            --get)       mode="get" ;;
            --set)       mode="set" ;;
            --new-world) new_world=1 ;;
            --*)         fail "$EX_USAGE" "Unknown option for config: $arg" ;;
            *)          [[ "$mode" == "get" || "$mode" == "set" ]] && value="$arg" ;;
        esac
    done

    # --list and --get are read-only and are useful before anything is
    # installed - they are how you find out what the defaults are. Only
    # the paths that write need an installation to write to.
    case "$mode" in
        list)
            if is_json; then
                local arr="[]"
                for key in $(config_keys); do
                    arr="$(jq -c -n --argjson acc "$arr" \
                        --arg k "$key" --arg v "$(cfg "$key")" \
                        --arg t "$(config_effective_type "$key")" \
                        --arg r "$(config_restart "$key")" \
                        --arg d "$(config_describe "$key")" \
                        '$acc + [{key:$k, value:$v, type:$t, restart_required:$r, description:$d}]')"
                done
                jq -n --argjson s "$arr" '{ok:true, settings:$s}'
            else
                out_title "Settings"
                local rows=("$(printf 'SETTING\tVALUE\tTYPE\tRESTART')")
                for key in $(config_keys); do
                    local shown; shown="$(cfg "$key")"
                    [[ "$key" == "SERVER_PASSWORD" && -n "$shown" ]] && shown="********"
                    rows+=("$(printf '%s\t%s\t%s\t%s' "$key" "${shown:--}" \
                        "$(config_effective_type "$key")" "$(config_restart "$key")")")
                done
                out_table "${rows[@]}"
                out_line ""
                out_line "  Change one:  coop config --set KEY=VALUE"
                out_line "  Details:     $FILE_CONFIG"
                out_line ""
            fi ;;
        get)
            [[ -n "${value:-}" ]] || fail "$EX_USAGE" "Usage: coop config --get KEY"
            [[ -n "${CONFIG_SPEC[$value]:-}" ]] || fail "$EX_CONFIG" "Unknown setting: $value"
            printf '%s\n' "$(cfg "$value")" ;;
        set)
            [[ -n "${value:-}" && "$value" == *=* ]] || fail "$EX_USAGE" "Usage: coop config --set KEY=VALUE"
            key="${value%%=*}"
            require_installation; require_root
            cfg_set "$key" "${value#*=}"
            [[ "$key" == "SAVE_NAME" ]] && _config_guard_save_name "$new_world"
            config_persist "$FILE_CONFIG" "$key"
            ok "$key = $( [[ "$key" == SERVER_PASSWORD ]] && printf '********' || cfg "$key" )"
            _config_apply_after_change "$key" ;;
        apply)
            require_installation; require_root
            _config_apply_after_change "" --force ;;
        *)
            require_installation; require_root
            (( NON_INTERACTIVE )) && fail "$EX_USAGE" \
                "Interactive configuration needs a terminal." \
                "Use: coop config --set KEY=VALUE"
            [[ "$mode" == "advanced" ]] && provision_collect_advanced || provision_collect_default
            config_validate_all
            provision_summary
            confirm "Save these settings?" yes || { log "Nothing was changed."; return 0; }
            mapfile -t _all_keys < <(config_keys)
            config_persist "$FILE_CONFIG" "${_all_keys[@]}"
            (( CAMPAIGN_NEW_WORLD_OK )) && campaign_allow_new_world "$(cfg SAVE_NAME)"
            _config_apply_after_change "" --force ;;
    esac
}

# The command-line route to SAVE_NAME gets the same protection as
# `coop campaign use`: a name with no campaign behind it is refused, unless
# a new world is what was asked for. A name that differs only in case is
# taken as the campaign it matches, spelled as it is on disk.
_config_guard_save_name() {
    local new_world="$1" wanted resolved
    wanted="$(cfg SAVE_NAME)"
    resolved="$(campaign_resolve "$wanted")"
    if [[ -n "$resolved" ]]; then
        [[ "$resolved" != "$wanted" ]] && cfg_set SAVE_NAME "$resolved"
        log "Tip: 'coop campaign use' does the same, with a backup and the restart included."
        return 0
    fi
    if (( new_world )); then
        campaign_allow_new_world "$wanted"
        log "A new world named '$wanted' is created when the server next starts."
        return 0
    fi
    fail "$EX_CONFIG" \
        "There is no campaign named '$wanted' in $DIR_SAVES. Nothing was changed." \
        "See the campaigns there are:   coop campaign list" \
        "To start a new world instead:  coop campaign new \"$wanted\"" \
        "                           or: coop config --set SAVE_NAME=\"$wanted\" --new-world"
}

# Regenerates what the server actually reads, and offers a restart only
# when the changed setting needs one.
_config_apply_after_change() {
    local key="${1:-}" force="${2:-}"
    config_write_compose_env
    server_config_render
    provision_install_units
    provision_install_motd

    local needs_restart=0
    if [[ "$force" == "--force" ]]; then needs_restart=1
    elif [[ -n "$key" && "$(config_restart "$key")" == "yes" ]]; then needs_restart=1; fi

    (( needs_restart )) || return 0
    container_running || return 0

    # Without a terminal there is nobody to ask, and the setting is saved
    # either way. Failing here reported a successful change as an error.
    if (( ! ASSUME_YES )) && ! is_interactive; then
        log "Restart for the change to take effect: coop restart"
        return 0
    fi
    if confirm "The server must restart for this to take effect. Restart now?" yes; then
        server_refresh_image
        server_stop && server_start
    else
        log "Restart later with: coop restart"
    fi
}

cmd_backup() {
    local sub="${1:-create}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        create|--note) : ;;
        list)    require_installation; backup_list; return ;;
        info)    require_installation; backup_info "${1:?Usage: coop backup info <id>}"; return ;;
        restore) require_installation; require_root; acquire_lock "backup restore"
                 # Without an ID, offer the list rather than failing: the
                 # ID is rarely something anyone remembers.
                 backup_restore "${1:-$(backup_select_interactive)}"; return ;;
        --auto)  require_installation; require_root; acquire_lock backup
                 backup_create auto >/dev/null; return ;;
        -*)      : ;;
        *)       fail "$EX_USAGE" "Unknown backup subcommand: $sub" ;;
    esac

    local note=""
    [[ "$sub" == "--note" ]] && note="${1:-}"
    while (( $# )); do
        case "$1" in
            --note) note="${2:-}"; shift 2 ;;
            *) note="$1"; shift ;;
        esac
    done

    require_installation; require_root; acquire_lock backup
    backup_create manual "$note"
    if is_json; then
        jq -n --arg file "$(basename "$BACKUP_LAST_ARCHIVE")" --arg dir "$DIR_BACKUPS" \
            '{ok:true, file:$file, directory:$dir}'
    fi
}

cmd_steam() {
    local sub="${1:-status}"
    [[ $# -gt 0 ]] && shift

    # Deliberately not gated on an existing installation. Authenticating
    # once and then provisioning unattended is the documented order, so
    # this is the command that has to be able to run first.
    case "$sub" in
        status)
            local probe="" st
            [[ "${1:-}" == "--probe" ]] && probe="--probe"
            st="$(steam_status $probe)"
            if is_json; then
                jq -n --arg s "$st" --arg u "$(cfg STEAM_USERNAME)" --arg e "$(steam_status_explain "$st")" \
                    '{ok:($s=="valid" or $s=="present"), session:$s, username:$u, detail:$e}'
            else
                out_title "Steam"
                out_kv "Account" "$( [[ -n "$(cfg STEAM_USERNAME)" ]] && cfg STEAM_USERNAME || printf 'not set' )"
                out_kv "Session" "$st"
                out_kv "Meaning" "$(steam_status_explain "$st")"
                out_line ""
            fi
            [[ "$st" == "valid" || "$st" == "present" ]] || return "$EX_STEAM" ;;
        login)  require_root; steam_prepare; steam_login "$@"
                config_persist "$FILE_CONFIG" STEAM_USERNAME ;;
        logout) require_installation; require_root; steam_logout ;;
        *) fail "$EX_USAGE" "Unknown steam subcommand: $sub" ;;
    esac
}

cmd_logs() {
    require_installation
    container_exists || fail "$EX_RUNTIME" "No container yet, so there is nothing to show."
    local follow=0 lines=100 arg
    while (( $# )); do
        arg="$1"
        case "$arg" in
            --follow|-f) follow=1; shift ;;
            -n) lines="${2:-100}"; shift 2 ;;
            *) shift ;;
        esac
    done
    if (( follow )); then
        docker logs -f --tail "$lines" "$CONTAINER_NAME" 2>&1 | tr -d '\r'
    else
        container_logs_tail "$lines"
    fi
}

cmd_eula() {
    local sub="${1:-status}"
    [[ $# -gt 0 ]] && shift
    require_installation
    server_installed || fail "$EX_RUNTIME" \
        "No server files are installed, so there are no license terms to show." \
        "Install them with: coop update --force"

    case "$sub" in
        status) license_status_report ;;
        show)   license_show "$DIR_SERVER" ;;
        accept)
            require_root
            local id; id="$(license_id "$DIR_SERVER")"
            if [[ -z "$id" ]]; then
                log "The installed build ships no license terms; there is nothing to accept."
                return 0
            fi
            if license_is_accepted "$id"; then
                ok "These license terms were already accepted ($(license_acceptance "$id" | jq -r .accepted_at))."
                return 0
            fi
            license_require "$DIR_SERVER" || exit "$EX_LICENSE"
            if ! container_running; then
                out_line ""
                out_line "  Start the server with: coop start"
                out_line ""
            fi ;;
        *) fail "$EX_USAGE" "Unknown eula subcommand: $sub" "Use: coop eula [status|show|accept]" ;;
    esac
}

# coop campaign [list] | use <name> | new <name>
cmd_campaign() {
    local sub="${1:-list}"
    [[ $# -gt 0 ]] && shift
    require_installation
    case "$sub" in
        list) campaign_list ;;
        use|new)
            (( $# <= 1 )) || fail "$EX_USAGE" \
                "Too many arguments. A name with spaces needs quotes:" \
                "  coop campaign $sub \"$*\""
            require_root; acquire_lock "campaign $sub"
            if [[ "$sub" == "use" ]]; then campaign_use "${1:-}"; else campaign_new "${1:-}"; fi ;;
        *) fail "$EX_USAGE" "Unknown campaign subcommand: $sub" \
               "Use: coop campaign [list | use \"<name>\" | new \"<name>\"]" ;;
    esac
}

# coop mods [list] | add <id>... | remove <id>... | update [--check]
cmd_mods() {
    local sub="${1:-list}"
    [[ $# -gt 0 ]] && shift
    require_installation
    case "$sub" in
        list)   mods_cmd_list ;;
        add)    require_root; acquire_lock "mods add";    mods_cmd_add "$@" ;;
        remove) require_root; acquire_lock "mods remove"; mods_cmd_remove "$@" ;;
        update)
            if [[ "${1:-}" == "--check" ]]; then
                mods_cmd_check
            else
                (( $# == 0 )) || fail "$EX_USAGE" "Unknown option for mods update: $1"
                require_root; acquire_lock "mods update"; mods_cmd_update
            fi ;;
        *) fail "$EX_USAGE" "Unknown mods subcommand: $sub" \
               "Use: coop mods [list | add <id>... | remove <id>... | update [--check]]" ;;
    esac
}

# coop ban [list] | coop ban <steam64-id> [--name "<hero name>"]
cmd_ban() {
    require_installation
    local id="${1:-list}" name=""
    [[ $# -gt 0 ]] && shift
    if [[ "$id" == "list" ]]; then
        ban_list
        return
    fi
    while (( $# )); do
        case "$1" in
            --name)   name="${2:-}"; shift 2 ;;
            --name=*) name="${1#--name=}"; shift ;;
            *) fail "$EX_USAGE" "Unknown option for ban: $1" "Usage: coop ban <steam64-id> [--name \"<hero name>\"]" ;;
        esac
    done
    require_root
    ban_add "$id" "$name"
}

cmd_unban() {
    require_installation
    [[ -n "${1:-}" ]] || fail "$EX_USAGE" "Usage: coop unban <steam64-id>"
    require_root
    ban_remove "$1"
}

cmd_version() {
    if is_json; then
        jq -n --arg m "$MANAGER_VERSION" --arg c "$(server_version)" \
              --arg ch "$(cfg INSTALL_CHANNEL)" \
            '{ok:true, manager_version:$m, coop_version:$c, install_channel:$ch}'
    else
        out_line "Bannerlord Coop Server Manager v${MANAGER_VERSION}"
        out_line "Installed Coop build:       $(server_version)"
        out_line ""
        out_line "The manager and the Coop mod are versioned separately."
    fi
}

# ------------------------------------------------------------ dispatch --
case "$COOP_COMMAND" in
    install)     cmd_install "$@" ;;
    status)      require_installation; status_report ;;
    start)       require_installation; require_root; acquire_lock start; server_start_or_exit ;;
    stop)        require_installation; require_root; acquire_lock stop; server_stop ;;
    restart)     require_installation; require_root; acquire_lock restart
                 server_refresh_image; server_stop; server_start_or_exit ;;
    save)        require_installation; require_root; server_save || exit "$EX_RUNTIME" ;;
    console)     require_installation
                 (( $# )) || fail "$EX_USAGE" "Usage: coop console <command>   (try: coop console players)"
                 server_cmd "$@"; sleep 2
                 out_section "--- server response ---"
                 docker logs --since 4s "$CONTAINER_NAME" 2>&1 | tr -d '\r' | grep -v '^[[:space:]]*$' | tail -30 ;;
    logs)        cmd_logs "$@" ;;
    config)      cmd_config "$@" ;;
    update)      require_installation
                 case "${1:-}" in
                     --check)     shift; update_check "$@" ;;
                     --scheduled) require_root; acquire_lock update; update_scheduled ;;
                     *)           require_root; acquire_lock update; update_apply "$@" ;;
                 esac ;;
    rollback)    require_installation; require_root; acquire_lock rollback; rollback_apply "$@" ;;
    backup)      cmd_backup "$@" ;;
    import-save) require_installation; require_root; acquire_lock import
                 backup_import_save "${1:?Usage: coop import-save <directory>}" ;;
    steam)       cmd_steam "$@" ;;
    eula)        cmd_eula "$@" ;;
    campaign)    cmd_campaign "$@" ;;
    campaigns)   cmd_campaign list ;;
    mods)        cmd_mods "$@" ;;
    ban)         cmd_ban "$@" ;;
    unban)       cmd_unban "$@" ;;
    doctor)      doctor_run ;;
    version)     cmd_version ;;
    help|-h|--help) usage ;;
    *)           error "Unknown command: $COOP_COMMAND"; out_line ""; usage; exit "$EX_USAGE" ;;
esac
