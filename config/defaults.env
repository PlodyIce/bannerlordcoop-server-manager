# Bannerlord Coop Server - project defaults
#
# The single place where every default value is defined. Nothing in this
# project may hard-code a default anywhere else; lib/config.sh describes the
# type and restart behaviour of each key, and `coop doctor` verifies that
# the two lists agree.
#
# Do not edit this file to configure your server. It is part of the project
# and is replaced on upgrade. Your settings live in:
#     $INSTALL_DIR/config/server.env

# ------------------------------------------------------------------ identity
INSTANCE_ID="default"
INSTALL_DIR="/srv/bannerlordcoop"
SERVER_LABEL="Bannerlord Coop Server"

# ------------------------------------------------------------ install source
# The Workshop is the supported channel. 'custom' exists so an alternative
# build can be installed from a local directory without changing any code.
INSTALL_CHANNEL="workshop"
WORKSHOP_APP_ID="261550"
WORKSHOP_ITEM_ID="3770450698"
CUSTOM_SOURCE_PATH=""

# --------------------------------------------------------------------- steam
# Only the account name. The password is never written anywhere; Steam's own
# session is kept under $INSTALL_DIR/state/steam.
STEAM_USERNAME=""

# ---------------------------------------------------------------------- mods
# Steam Workshop IDs, in load order. Empty runs the server exactly as the
# Coop team ships it. Change them with `coop mods`, which also downloads,
# backs up and restarts; see docs/MODS.md.
MODS=""
DOTNET_SDK_IMAGE="mcr.microsoft.com/dotnet/sdk:10.0"

# ---------------------------------------------------------------- the server
# SAVE_NAME decides between continuing a campaign and starting a new world:
# an existing save of this name is loaded, otherwise a fresh world is created
# and saved under it.
SAVE_NAME="Campaign"
SERVER_PASSWORD=""
GAME_PORT="4200"
AUTOSAVE_MINUTES="5"

# Off by default. With a logged-in Steam client on the host this would
# advertise a *public* lobby; a private group almost never wants that, and
# without a Steam client the setting does nothing either way.
STEAM_ADVERTISE="false"
SERVER_LOG_FILE="true"

# -------------------------------------------------------------------- runtime
# 'system' adopts the host time zone, so log timestamps match the host's.
TIMEZONE="system"

# A few lines about this server in the message shown at an SSH login: a
# Workshop update waiting, and the last backup. Ubuntu and Debian only.
LOGIN_MESSAGE="true"

# Empty means no limit. Measured usage is 1.2-1.6 GB; a limit is worth
# setting on a small host so a leak cannot take SSH down with it.
MEMORY_LIMIT=""

# Overwritten at install time with the ID of the user that owns the data
# directories. 1000 is only the fallback.
PUID="1000"
PGID="1000"
WINE_BRANCH="stable"

# -------------------------------------------------------------------- backups
# Hourly is cheap: when nobody is connected the campaign is paused and the
# save is byte-identical, so the backup is skipped entirely.
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="hourly"

# Retention per reason, because the reasons are not equally replaceable.
# Automatic backups are a rolling window; manual and pre-restore backups
# exist because somebody deliberately made them.
BACKUP_KEEP_AUTO="48"
BACKUP_KEEP_MANUAL="20"
BACKUP_KEEP_PREUPDATE="10"
BACKUP_KEEP_PRERESTORE="10"

# Second and third safety nets against a full disk. 0 disables either limit.
BACKUP_MAX_AGE_DAYS="30"
BACKUP_MAX_TOTAL_GB="20"

# -------------------------------------------------------------------- updates
# Deliberately off. The server verifies its Coop assemblies, and every player
# must run the same build - an unattended update would lock out anyone who
# has not updated their client yet. The check still runs and reports.
AUTO_UPDATE="false"
UPDATE_CHECK_ENABLED="true"
UPDATE_CHECK_SCHEDULE="*-*-* 04:00:00"

# ------------------------------------------------------------------- advanced
# Pin this to a digest (image@sha256:...) if you need reproducible installs.
STEAMCMD_IMAGE="steamcmd/steamcmd:ubuntu"
LOG_MAX_SIZE="50m"
LOG_MAX_FILES="5"
